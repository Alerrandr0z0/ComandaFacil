# ── PostgreSQL (Banco de Escrita) ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=comandafacil
POSTGRES_USER=comandafacil
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://comandafacil:change_me_in_production@localhost:5432/comandafacil

# ── MongoDB (Banco de Leitura) ───────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=comandafacil_read
MONGO_USER=comandafacil
MONGO_PASSWORD=change_me_in_production
MONGO_URL=mongodb://comandafacil:change_me_in_production@localhost:27017/comandafacil_read?authSource=admin

# ── Aplicação ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs/franquias
LOG_ROTATION_WHEN=midnight
LOG_BACKUP_COUNT=30

# ── Stripe (Pagamentos) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
