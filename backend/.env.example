# App
APP_ENV=development
APP_SECRET_KEY=change_me_in_production
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (Write DB)
DATABASE_URL=postgresql+asyncpg://comandafacil:change_me@localhost:5432/comandafacil

# MongoDB (Read DB)
MONGO_URL=mongodb://comandafacil:change_me@localhost:27017/comandafacil_read?authSource=admin
MONGO_DB=comandafacil_read

# JWT
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs/franquias
LOG_ROTATION_WHEN=midnight
LOG_BACKUP_COUNT=30

# Stripe
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
